<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationIcon>Assets\JMD.ico</ApplicationIcon>
    <Version>0.1.9</Version>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\JMD.Core\JMD.Core.csproj" />
    <ProjectReference Include="..\JMD.Tools\JMD.Tools.csproj" />
    <ProjectReference Include="..\JMD.Windows\JMD.Windows.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="Assets\JMD.ico" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Resource Include="Assets\JMD.png" />
  </ItemGroup>
</Project>
