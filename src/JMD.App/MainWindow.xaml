                              <DockPanel LastChildFill="False">
                                <TextBlock Text="Original" Foreground="#FF969BA7" FontSize="11" VerticalAlignment="Center" />
                                <Button Tag="{Binding BeforeValue}" Click="CopyHistoryValue_Click" ToolTip="Copiar valor original"
                                        Padding="5,2" Margin="4,0,0,0" Background="#FF30343E" Foreground="White" BorderThickness="0">
                                  <TextBlock Text="&#xE8C8;" FontFamily="Segoe MDL2 Assets" FontSize="12" />
                                </Button>
                              </DockPanel>
                              <TextBlock Text="{Binding BeforeValue}" Foreground="White" TextWrapping="Wrap"
                                         FontFamily="Consolas" Margin="0,3,0,0" />
                            </StackPanel>
                            <Border Grid.Column="1" BorderBrush="#FF3A3E48" BorderThickness="1,0,0,0" HorizontalAlignment="Center" />
                            <StackPanel Grid.Column="2">
                              <DockPanel LastChildFill="False">
                                <TextBlock Text="Resultado" Foreground="#FF969BA7" FontSize="11" VerticalAlignment="Center" />
                                <Button Tag="{Binding AfterValue}" Click="CopyHistoryValue_Click" ToolTip="Copiar resultado"
                                        Padding="5,2" Margin="4,0,0,0" Background="#FF30343E" Foreground="White" BorderThickness="0">
                                  <TextBlock Text="&#xE8C8;" FontFamily="Segoe MDL2 Assets" FontSize="12" />
                                </Button>
                              </DockPanel>
                              <TextBlock Text="{Binding AfterValue}" Foreground="White" TextWrapping="Wrap"
                                         FontFamily="Consolas" Margin="0,3,0,0" />
                            </StackPanel>
                          </Grid>
                        </StackPanel>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
              <DockPanel Grid.Row="1" Margin="0,8,0,0" LastChildFill="False" HorizontalAlignment="Center">
                <Button x:Name="PreviousHistoryPageButton" Content="‹ Anterior" Click="PreviousHistoryPage_Click"
                        Padding="10,5" Background="#FF30343E" Foreground="White" BorderThickness="0" />
                <TextBlock x:Name="HistoryPageText" Text="Página 0 de 0" Foreground="#FFBFC3CC"
                           VerticalAlignment="Center" Margin="12,0" />
                <Button x:Name="NextHistoryPageButton" Content="Próxima ›" Click="NextHistoryPage_Click"
                        Padding="10,5" Background="#FF30343E" Foreground="White" BorderThickness="0" />
              </DockPanel>
            </Grid>
          </Grid>
        </Grid>
        <Grid x:Name="AdvancedSettingsPage" Visibility="Collapsed" Background="#FF17191F">
          <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="14">
            <TextBlock Text="Notificações" Foreground="White" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10" />
            <Border Background="#FF22252D" BorderBrush="#FF31343D" BorderThickness="1" CornerRadius="10" Padding="14">
              <StackPanel>
                <CheckBox x:Name="AdvancedNotificationsToggle" Content="Usar notificações próprias do JMD"
                          Style="{StaticResource CompactToggleCheckBoxStyle}" FontSize="13" FontWeight="SemiBold"
                          Checked="AdvancedNotificationsToggle_Changed" Unchecked="AdvancedNotificationsToggle_Changed" />
                <TextBlock Text="Substitui o balão e o som padrão do Windows por uma janela discreta do JMD. O som de ativação do JMD continua funcionando."
                           Foreground="#FF969BA7" FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0" />
              </StackPanel>
            </Border>
            <TextBlock Text="Sons de sinalização" Foreground="White" FontSize="16" FontWeight="SemiBold" Margin="0,18,0,10" />
            <Border Background="#FF22252D" BorderBrush="#FF31343D" BorderThickness="1" CornerRadius="10" Padding="14">
              <StackPanel>
                <TextBlock Text="Escolha um som para cada evento. Use Ouvir para testar; a preferência é salva automaticamente." Foreground="#FF969BA7" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,10" />
                <Grid Margin="0,3"><Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/><ColumnDefinition Width="68"/></Grid.ColumnDefinitions>
                  <TextBlock Text="Atalho executado" Foreground="#FFBFC3CC" VerticalAlignment="Center" />
                  <ComboBox x:Name="ShortcutSoundCombo" Grid.Column="1" Style="{StaticResource JeyModelComboBoxStyle}" SelectionChanged="AdvancedSoundSelection_Changed">
                    <ComboBoxItem Content="Clássico" Tag="classic"/><ComboBoxItem Content="Suave" Tag="soft"/><ComboBoxItem Content="Sino" Tag="chime"/><ComboBoxItem Content="Duplo" Tag="double"/><ComboBoxItem Content="Sem som" Tag="none"/>
                  </ComboBox>
                  <Button Grid.Column="2" Content="Ouvir" Tag="shortcut" Click="PreviewSignalSound_Click" Margin="6,0,0,0" Padding="6,4" Background="#FF30343E" Foreground="White" BorderThickness="0" />
                </Grid>
                <Grid Margin="0,3"><Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/><ColumnDefinition Width="68"/></Grid.ColumnDefinitions>
                  <TextBlock Text="Comando de voz" Foreground="#FFBFC3CC" VerticalAlignment="Center" />
                  <ComboBox x:Name="VoiceCommandSoundCombo" Grid.Column="1" Style="{StaticResource JeyModelComboBoxStyle}" SelectionChanged="AdvancedSoundSelection_Changed">
                    <ComboBoxItem Content="Clássico" Tag="classic"/><ComboBoxItem Content="Suave" Tag="soft"/><ComboBoxItem Content="Sino" Tag="chime"/><ComboBoxItem Content="Duplo" Tag="double"/><ComboBoxItem Content="Sem som" Tag="none"/>
                  </ComboBox>
                  <Button Grid.Column="2" Content="Ouvir" Tag="voice" Click="PreviewSignalSound_Click" Margin="6,0,0,0" Padding="6,4" Background="#FF30343E" Foreground="White" BorderThickness="0" />
                </Grid>
                <Grid Margin="0,3"><Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/><ColumnDefinition Width="68"/></Grid.ColumnDefinitions>
                  <TextBlock Text="Jey reconhecido" Foreground="#FFBFC3CC" VerticalAlignment="Center" />
                  <ComboBox x:Name="JeySoundCombo" Grid.Column="1" Style="{StaticResource JeyModelComboBoxStyle}" SelectionChanged="AdvancedSoundSelection_Changed">
                    <ComboBoxItem Content="Clássico" Tag="classic"/><ComboBoxItem Content="Suave" Tag="soft"/><ComboBoxItem Content="Sino" Tag="chime"/><ComboBoxItem Content="Duplo" Tag="double"/><ComboBoxItem Content="Sem som" Tag="none"/>
                  </ComboBox>
                  <Button Grid.Column="2" Content="Ouvir" Tag="jey" Click="PreviewSignalSound_Click" Margin="6,0,0,0" Padding="6,4" Background="#FF30343E" Foreground="White" BorderThickness="0" />
                </Grid>
                <Grid Margin="0,3"><Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/><ColumnDefinition Width="68"/></Grid.ColumnDefinitions>
                  <TextBlock Text="Lembrete de tarefa" Foreground="#FFBFC3CC" VerticalAlignment="Center" />
                  <ComboBox x:Name="TaskReminderSoundCombo" Grid.Column="1" Style="{StaticResource JeyModelComboBoxStyle}" SelectionChanged="AdvancedSoundSelection_Changed">
                    <ComboBoxItem Content="Clássico" Tag="classic"/><ComboBoxItem Content="Suave" Tag="soft"/><ComboBoxItem Content="Sino" Tag="chime"/><ComboBoxItem Content="Duplo" Tag="double"/><ComboBoxItem Content="Sem som" Tag="none"/>
                  </ComboBox>
                  <Button Grid.Column="2" Content="Ouvir" Tag="reminder" Click="PreviewSignalSound_Click" Margin="6,0,0,0" Padding="6,4" Background="#FF30343E" Foreground="White" BorderThickness="0" />
                </Grid>
                <TextBlock Text="O som do lembrete é independente dos demais. Com notificações padrão do Windows, o próprio Windows também pode emitir seu som de notificação." Foreground="#FF969BA7" FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0" />
              </StackPanel>
            </Border>
            <TextBlock Text="Diagnóstico" Foreground="White" FontSize="16" FontWeight="SemiBold" Margin="0,18,0,10" />
            <Border Background="#FF22252D" BorderBrush="#FF31343D" BorderThickness="1" CornerRadius="10" Padding="14">
              <StackPanel>
                <TextBlock Text="Falhas críticas e exceções não tratadas são registradas com detalhes técnicos." Foreground="#FF969BA7" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,10" />
                <Button Content="Abrir log de falhas críticas" Click="OpenCriticalLogs_Click" HorizontalAlignment="Left"
                        Padding="11,7" Background="#FF30343E" Foreground="White" BorderThickness="0" />
                <TextBlock Text="%LOCALAPPDATA%\JMD\logs\critical.log" Foreground="#FF777D89" FontSize="10" TextWrapping="Wrap" Margin="0,8,0,0" />
              </StackPanel>
            </Border>
          </StackPanel>
          </ScrollViewer>
        </Grid>
      </Grid>
      <Grid x:Name="AboutPage" Grid.Row="2" Visibility="Collapsed" Background="#FF17191F">
        <Border Background="#FF22252D" BorderBrush="#FF31343D" BorderThickness="1" CornerRadius="12"
                Padding="24" HorizontalAlignment="Center" VerticalAlignment="Center" Width="430">
          <StackPanel>
            <TextBlock Text="JMD" Foreground="White" FontSize="24" FontWeight="Bold" />
            <TextBlock Text="Ferramentas rápidas para desenvolvimento" Foreground="#FF969BA7" FontSize="13" Margin="0,4,0,18" />
            <TextBlock x:Name="AboutVersionText" Foreground="White" FontSize="12" />
            <TextBlock Text="Projeto open source" Foreground="#FF969BA7" FontSize="12" Margin="0,5,0,16" />
            <TextBlock x:Name="UpdateStatusText" Text="Verifique se há uma versão mais recente no GitHub." Foreground="#FFB4F36A"
                       TextWrapping="Wrap" FontSize="12" Margin="0,0,0,14" />
            <CheckBox x:Name="SilentUpdateToggle" Content="Instalar atualização em modo silencioso"
                      Style="{StaticResource CompactToggleCheckBoxStyle}" FontSize="12" Margin="0,0,0,12"
                      Visibility="Collapsed" Checked="SilentUpdateToggle_Changed" Unchecked="SilentUpdateToggle_Changed" />
            <StackPanel Orientation="Horizontal">
              <Button x:Name="CheckUpdatesButton" Content="Verificar atualizações" Click="CheckUpdatesButton_Click"
                      Style="{StaticResource JeyPrimaryButtonStyle}" />
              <Button x:Name="InstallUpdateButton" Content="Atualizar agora" Click="InstallUpdateButton_Click"
                      Style="{StaticResource JeyPrimaryButtonStyle}" Margin="8,0,0,0" Visibility="Collapsed" />
            </StackPanel>
            <TextBlock x:Name="UpdateProgressText" Foreground="#FFBFC3CC" FontSize="11"
                       TextWrapping="Wrap" Margin="0,12,0,0" Visibility="Collapsed" />
            <ProgressBar x:Name="UpdateDownloadProgress" Minimum="0" Maximum="100" Value="0" Height="5"
                         Margin="0,7,0,0" Background="#FF3A3E48" Foreground="{StaticResource AccentBrush}"
                         BorderThickness="0" Visibility="Collapsed" />
          </StackPanel>
        </Border>
      </Grid>
      <Grid x:Name="JeySettingsPage" Grid.Row="2" Visibility="Collapsed" Background="#FF17191F">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="18">
          <TextBlock Text="Configurações do Jey" Foreground="White" FontSize="18" FontWeight="SemiBold" />
          <CheckBox x:Name="VoiceDebugToggle" Content="Histórico detalhado de áudio"
                    Style="{StaticResource CompactToggleCheckBoxStyle}" Margin="0,18,0,0"
                    Checked="VoiceDebugToggle_Changed" Unchecked="VoiceDebugToggle_Changed"
                    ToolTip="Guarda no histórico a duração, o ponto de corte e o trecho enviado aos modelos de transcrição." />
          <TextBlock Text="Guarda detalhes da captura nos registros de comandos de voz do histórico."
                     Foreground="#FF969BA7" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0" />
          <CheckBox x:Name="VoiceRecognitionDebugToggle" Content="Depuração de áudio"
                    Style="{StaticResource CompactToggleCheckBoxStyle}" Margin="0,16,0,0"
                    Checked="VoiceRecognitionDebugToggle_Changed" Unchecked="VoiceRecognitionDebugToggle_Changed"
                    ToolTip="Mostra os resultados do Vosk de ativação e as tentativas de transcrição em português e inglês." />
          <DockPanel x:Name="AudioDebugSessionControls" LastChildFill="False" Margin="0,6,0,0" Visibility="Collapsed">
            <TextBlock x:Name="AudioDebugCountdownText" Text="Encerra em 05:00" Foreground="#FFB4F36A" FontSize="11" VerticalAlignment="Center" />
            <Button Content="Postergar 5 min" Click="PostponeAudioDebug_Click" DockPanel.Dock="Right"
                    Padding="8,4" Margin="8,0,0,0" Background="#FF30343E" Foreground="White"
                    BorderThickness="0" FontSize="10" />
            <Button Content="Parar" Click="StopAudioDebug_Click" DockPanel.Dock="Right"
                    Padding="8,4" Background="#FF30343E" Foreground="White" BorderThickness="0" FontSize="10" />
          </DockPanel>
          <TextBlock Text="Exibe o que o Vosk ouviu para ativar o Jey e o texto, a confiança estimada ou o erro de cada modelo usado no trecho após o corte. As confianças ajudam no diagnóstico, mas não são uma medida calibrada para comparar modelos diferentes."
                     Foreground="#FF969BA7" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0" />
          <Border x:Name="VoiceRecognitionDebugPanel" Background="#FF22252D" BorderBrush="#FF31343D" BorderThickness="1"
                  CornerRadius="8" Padding="10" Margin="0,10,0,0" Visibility="Collapsed">
            <StackPanel>
              <TextBlock Text="Reconhecimento de ativação · Vosk" Foreground="#FFB4F36A" FontSize="11" FontWeight="SemiBold" />
              <TextBlock x:Name="VoiceRecognitionDebugText" Text="Parcial: (aguardando)" Foreground="White" FontSize="12"
                         TextWrapping="Wrap" Margin="0,5,0,8" />
              <DockPanel LastChildFill="False" Margin="0,0,0,4">
                <TextBlock Text="Eventos mais recentes" Foreground="#FF969BA7" FontSize="10" VerticalAlignment="Center" />
                <Button Content="Limpar" Click="ClearVoiceRecognitionDebugHistory_Click" DockPanel.Dock="Right"
                        Padding="7,3" Background="#FF30343E" Foreground="White" BorderThickness="0"
                        FontSize="10" ToolTip="Limpar os resultados desta sessão de depuração" />
              </DockPanel>
              <ScrollViewer x:Name="VoiceRecognitionDebugScrollViewer" Height="240" VerticalScrollBarVisibility="Auto"
                            Background="#FF191B21">
                <ItemsControl x:Name="VoiceRecognitionDebugHistory">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Grid Margin="4,3">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="64"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Time}" Foreground="#FF969BA7" FontFamily="Consolas" FontSize="10" />
                        <TextBlock Grid.Column="1" Text="{Binding Message}" Foreground="White" FontSize="11" TextWrapping="Wrap" />
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
            </StackPanel>
          </Border>
          <TextBlock Text="Modelos de transcrição após ativar o Jey" Foreground="White" FontSize="14" FontWeight="SemiBold" Margin="0,22,0,8" />
          <Border Background="{StaticResource CardBrush}" BorderBrush="#FF31343D" BorderThickness="1" CornerRadius="10" Padding="12">
            <StackPanel>
              <TextBlock Text="Escolha os idiomas usados para entender o que você fala depois de dizer “Jey”. O Vosk em inglês que escuta continuamente a palavra de ativação permanece ativo." Foreground="{StaticResource MutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,12" />
              <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <TextBlock Text="Português" Foreground="#FFBFC3CC" VerticalAlignment="Center" />
                <ComboBox x:Name="PortugueseModelCombo" Grid.Column="1" Style="{StaticResource JeyModelComboBoxStyle}" SelectionChanged="JeyTranscriptionModel_Changed">
                  <ComboBoxItem Content="Desativado" Tag="disabled" />
                  <ComboBoxItem Content="Vosk · incluído" Tag="vosk" />
                  <ComboBoxItem Content="Whisper Tiny · rápido" Tag="whisperTiny" />
                  <ComboBoxItem Content="Whisper Base · equilibrado" Tag="whisperBase" />
                  <ComboBoxItem Content="Gemma E2B · experimental" Tag="gemma4E2B" />
                  <ComboBoxItem Content="Sherpa Parakeet pt-BR · experimental" Tag="sherpaParakeetPtBr" />
                </ComboBox>
              </Grid>
              <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <TextBlock Text="Inglês" Foreground="#FFBFC3CC" VerticalAlignment="Center" />
                <ComboBox x:Name="EnglishModelCombo" Grid.Column="1" Style="{StaticResource JeyModelComboBoxStyle}" SelectionChanged="JeyTranscriptionModel_Changed">
                  <ComboBoxItem Content="Desativado" Tag="disabled" />
                  <ComboBoxItem Content="Vosk · incluído" Tag="vosk" />
                  <ComboBoxItem Content="Whisper Tiny · rápido" Tag="whisperTiny" />
                  <ComboBoxItem Content="Whisper Base · equilibrado" Tag="whisperBase" />
                  <ComboBoxItem Content="Gemma E2B · experimental" Tag="gemma4E2B" />
                  <ComboBoxItem Content="Sherpa Zipformer · inglês" Tag="sherpaZipformerEn" />
                </ComboBox>
              </Grid>
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <TextBlock Text="Ativação Jey" Foreground="#FFBFC3CC" VerticalAlignment="Center" />
                <ComboBox Grid.Column="1" Style="{StaticResource JeyModelComboBoxStyle}" IsEnabled="False" SelectedIndex="0">
                  <ComboBoxItem Content="Vosk inglês · escuta contínua" />
                </ComboBox>
              </Grid>
              <TextBlock Text="Palavras adicionais para ativar o Jey" Foreground="#FFBFC3CC" FontSize="12" Margin="0,14,0,5" />
              <TextBox x:Name="JeyAdditionalWakeWordsTextBox" MinHeight="66" MaxHeight="120" AcceptsReturn="True"
                       TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Padding="8"
                       Background="#FF191B21" Foreground="White" BorderBrush="#FF414550"
                       LostFocus="JeyAdditionalWakeWords_LostFocus"
                       ToolTip="Digite uma palavra por linha. Exemplo: Jarbas" />
              <TextBlock Text="Uma palavra por linha. Exemplo: Jarbas. As palavras são incluídas na gramática fechada de ativação quando ela está ligada."
                         Foreground="{StaticResource MutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="2,5,2,0" />
              <CheckBox x:Name="ClosedWakeWordGrammarToggle" Content="Gramática fechada para a ativação (experimental)"
                        Style="{StaticResource CompactToggleCheckBoxStyle}" Margin="0,14,0,0"
                        Checked="ClosedWakeWordGrammarToggle_Changed" Unchecked="ClosedWakeWordGrammarToggle_Changed"
                        ToolTip="Restringe somente o Vosk que escuta continuamente a palavra jay. Não altera os modelos de transcrição." />
              <TextBlock Text="Quando ativada, limita o vocabulário do recognizer de ativação a “jay”. Pode reduzir confusões, mas também causar ativações falsas; teste com a depuração ligada."
                         Foreground="{StaticResource MutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="2,5,2,8" />
              <CheckBox x:Name="ClosedCommandGrammarToggle" Content="Gramática fechada para interpretar comandos (experimental)"
                        Style="{StaticResource CompactToggleCheckBoxStyle}" Margin="0,10,0,0"
                        Checked="ClosedCommandGrammarToggle_Changed" Unchecked="ClosedCommandGrammarToggle_Changed"
                        ToolTip="Limita o Vosk usado após a ativação às frases dos comandos ativos configurados no Jey." />
              <TextBlock Text="No Vosk, restringe o reconhecimento às frases dos comandos ativos. Nos modelos Sherpa, usa essas frases como hotwords para favorecer os comandos. Whisper e Gemma continuam com vocabulário aberto. Sem frases configuradas, os mecanismos usam vocabulário aberto."
                         Foreground="{StaticResource MutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="2,5,2,8" />
              <DockPanel LastChildFill="False">
                <TextBlock Text="Confiança mínima do comando" Foreground="#FFBFC3CC" FontSize="12" VerticalAlignment="Center" />
                <TextBlock x:Name="CommandMinimumConfidenceText" DockPanel.Dock="Right" Text="Desativada"
                           Foreground="White" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
              </DockPanel>
              <Slider x:Name="CommandMinimumConfidenceSlider" Minimum="0" Maximum="100" Value="0"
                      TickFrequency="5" IsSnapToTickEnabled="True" SmallChange="5" LargeChange="10"
                      Margin="0,5,0,0" ValueChanged="CommandMinimumConfidenceSlider_Changed"
                      ToolTip="Rejeita transcrições do Vosk abaixo deste limite quando a gramática fechada de comandos está ativa. Zero desativa o filtro." />
              <TextBlock Text="Use o histórico de depuração para ajustar este valor. Ele filtra somente a confiança do Vosk nos comandos; zero aceita qualquer confiança disponível."
                         Foreground="{StaticResource MutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="2,2,2,0" />
              <DockPanel LastChildFill="False">
                <TextBlock Text="Confiança mínima do Vosk" Foreground="#FFBFC3CC" FontSize="12" VerticalAlignment="Center" />
                <TextBlock x:Name="WakeWordMinimumConfidenceText" DockPanel.Dock="Right" Text="Desativada"
                           Foreground="White" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
              </DockPanel>
              <Slider x:Name="WakeWordMinimumConfidenceSlider" Minimum="0" Maximum="100" Value="0"
                      TickFrequency="5" IsSnapToTickEnabled="True" SmallChange="5" LargeChange="10"
                      Margin="0,5,0,0" ValueChanged="WakeWordMinimumConfidenceSlider_Changed"
                      ToolTip="Rejeita uma ativação abaixo deste valor e, ao combinar Vosk com Whisper, só escolhe a transcrição Vosk quando ela alcança este limite. Zero desativa o limite." />
              <TextBlock Text="O limite filtra a palavra de ativação e ajuda a escolher o Vosk quando ele é combinado com o Whisper. Com dois Vosk ou dois Whisper, são feitas transcrições em português e inglês e a de maior confiança é escolhida."
                         Foreground="{StaticResource MutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="2,2,2,0" />
            </StackPanel>
          </Border>
          <TextBlock Text="Os modelos opcionais são baixados para este computador e podem ser removidos separadamente."
                     Foreground="{StaticResource MutedBrush}" FontSize="12" TextWrapping="Wrap" Margin="2,8,2,12" />
          <UniformGrid Columns="2">
            <Border Background="{StaticResource CardBrush}" BorderBrush="#FF31343D" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,8,8">
              <StackPanel>
                <TextBlock Text="Vosk" Foreground="White" FontSize="14" FontWeight="SemiBold" />
                <TextBlock Text="Mais rápido · modelos incluídos · PT + EN" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,4,0,10" />
                <TextBlock Text="Disponível com o JMD. O Vosk inglês também mantém a escuta da palavra Jey." Foreground="#FFBFC3CC" FontSize="11" TextWrapping="Wrap" />
                <TextBlock Text="Incluído no aplicativo" Foreground="#FFB4F36A" FontSize="11" Margin="0,10,0,0" />
              </StackPanel>
            </Border>
            <Border Background="{StaticResource CardBrush}" BorderBrush="#FF31343D" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,8">
              <StackPanel>
                <TextBlock Text="Whisper Tiny" Foreground="White" FontSize="14" FontWeight="SemiBold" />
                <TextBlock Text="Rápido · 32 MiB · local · multilíngue" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,4,0,10" />
                <StackPanel Orientation="Horizontal">
                  <Button x:Name="DownloadWhisperTinyButton" Tag="whisperTiny" Content="Baixar" Click="DownloadVoiceModel_Click"
                          Padding="11,6" Background="{StaticResource AccentBrush}" Foreground="{StaticResource SurfaceBrush}" FontWeight="SemiBold" BorderThickness="0" />
                  <Button x:Name="DeleteWhisperTinyButton" Tag="whisperTiny" Content="Remover" Click="DeleteVoiceModel_Click"
                          Style="{StaticResource JeySecondaryButtonStyle}" Margin="7,0,0,0" />
                </StackPanel>
                <ProgressBar x:Name="WhisperTinyDownloadProgress" Minimum="0" Maximum="100" Height="4" Margin="0,9,0,0"
                             Background="#FF3A3E48" Foreground="{StaticResource AccentBrush}" BorderThickness="0" Visibility="Collapsed" />
                <TextBlock x:Name="WhisperTinyStatusText" Text="Ainda não baixado." Foreground="{StaticResource MutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,7,0,0" />
              </StackPanel>
            </Border>
            <Border Background="{StaticResource CardBrush}" BorderBrush="#FF31343D" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,8,8">
              <StackPanel>
                <TextBlock Text="Whisper Base" Foreground="White" FontSize="14" FontWeight="SemiBold" />
                <TextBlock Text="Equilibrado · 142 MiB · local · multilíngue" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,4,0,10" />
                <StackPanel Orientation="Horizontal">
                  <Button x:Name="DownloadWhisperBaseButton" Tag="whisperBase" Content="Baixar" Click="DownloadVoiceModel_Click"
                          Padding="11,6" Background="{StaticResource AccentBrush}" Foreground="{StaticResource SurfaceBrush}" FontWeight="SemiBold" BorderThickness="0" />
                  <Button x:Name="DeleteWhisperBaseButton" Tag="whisperBase" Content="Remover" Click="DeleteVoiceModel_Click"
                          Style="{StaticResource JeySecondaryButtonStyle}" Margin="7,0,0,0" />
                </StackPanel>
                <ProgressBar x:Name="WhisperBaseDownloadProgress" Minimum="0" Maximum="100" Height="4" Margin="0,9,0,0"
                             Background="#FF3A3E48" Foreground="{StaticResource AccentBrush}" BorderThickness="0" Visibility="Collapsed" />
                <TextBlock x:Name="WhisperBaseStatusText" Text="Ainda não baixado." Foreground="{StaticResource MutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,7,0,0" />
              </StackPanel>
            </Border>
            <Border Background="{StaticResource CardBrush}" BorderBrush="#FF31343D" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,8">
              <StackPanel>
                <TextBlock Text="Gemma E2B" Foreground="White" FontSize="14" FontWeight="SemiBold" />
                <TextBlock Text="Experimental · cerca de 3,4 GiB · local" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,4,0,10" />
                <TextBlock Text="Modelo de áudio generativo; pode responder mais devagar. Requer 3,5 GiB livres para baixar." Foreground="#FFBFC3CC" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,9" />
                <StackPanel Orientation="Horizontal">
                  <Button x:Name="DownloadGemmaButton" Tag="gemma4E2B" Content="Baixar Gemma" Click="DownloadVoiceModel_Click"
                          Padding="11,6" Background="{StaticResource AccentBrush}" Foreground="{StaticResource SurfaceBrush}" FontWeight="SemiBold" BorderThickness="0" />
                  <Button x:Name="DeleteGemmaButton" Tag="gemma4E2B" Content="Remover" Click="DeleteVoiceModel_Click"
                          Style="{StaticResource JeySecondaryButtonStyle}" Margin="7,0,0,0" />
                </StackPanel>
                <ProgressBar x:Name="GemmaDownloadProgress" Minimum="0" Maximum="100" Height="4" Margin="0,9,0,0"
                             Background="#FF3A3E48" Foreground="{StaticResource AccentBrush}" BorderThickness="0" Visibility="Collapsed" />
                <TextBlock x:Name="GemmaStatusText" Text="Ainda não baixado." Foreground="{StaticResource MutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,7,0,0" />
              </StackPanel>
          </Border>
            <Border Background="{StaticResource CardBrush}" BorderBrush="#FF31343D" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,8,8">
              <StackPanel>
                <TextBlock Text="Sherpa Parakeet pt-BR" Foreground="White" FontSize="14" FontWeight="SemiBold" />
                <TextBlock Text="Experimental · 640 MiB · transdutor ONNX local" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,4,0,10" />
                <TextBlock Text="Ajustado para português brasileiro. A gramática usa hotwords para dar preferência aos comandos; não limita totalmente as frases reconhecidas." Foreground="#FFBFC3CC" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,9" />
                <StackPanel Orientation="Horizontal">
                  <Button x:Name="DownloadSherpaPtButton" Tag="sherpaParakeetPtBr" Content="Baixar Sherpa PT" Click="DownloadVoiceModel_Click" Padding="11,6" Background="{StaticResource AccentBrush}" Foreground="{StaticResource SurfaceBrush}" FontWeight="SemiBold" BorderThickness="0" />
                  <Button x:Name="DeleteSherpaPtButton" Tag="sherpaParakeetPtBr" Content="Remover" Click="DeleteVoiceModel_Click" Style="{StaticResource JeySecondaryButtonStyle}" Margin="7,0,0,0" />
                </StackPanel>
                <ProgressBar x:Name="SherpaPtDownloadProgress" Minimum="0" Maximum="100" Height="4" Margin="0,9,0,0" Background="#FF3A3E48" Foreground="{StaticResource AccentBrush}" BorderThickness="0" Visibility="Collapsed" />
                <TextBlock x:Name="SherpaPtStatusText" Text="Ainda não baixado." Foreground="{StaticResource MutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,7,0,0" />
              </StackPanel>
            </Border>
            <Border Background="{StaticResource CardBrush}" BorderBrush="#FF31343D" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,8">
              <StackPanel>
                <TextBlock Text="Sherpa Zipformer inglês" Foreground="White" FontSize="14" FontWeight="SemiBold" />
                <TextBlock Text="Experimental · cerca de 29 MiB · local" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,4,0,10" />
                <TextBlock Text="Modelo oficial de inglês. A gramática fechada fornece hotwords para priorizar os comandos." Foreground="#FFBFC3CC" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,9" />
                <StackPanel Orientation="Horizontal">
                  <Button x:Name="DownloadSherpaEnButton" Tag="sherpaZipformerEn" Content="Baixar Sherpa EN" Click="DownloadVoiceModel_Click" Padding="11,6" Background="{StaticResource AccentBrush}" Foreground="{StaticResource SurfaceBrush}" FontWeight="SemiBold" BorderThickness="0" />
                  <Button x:Name="DeleteSherpaEnButton" Tag="sherpaZipformerEn" Content="Remover" Click="DeleteVoiceModel_Click" Style="{StaticResource JeySecondaryButtonStyle}" Margin="7,0,0,0" />
                </StackPanel>
                <ProgressBar x:Name="SherpaEnDownloadProgress" Minimum="0" Maximum="100" Height="4" Margin="0,9,0,0" Background="#FF3A3E48" Foreground="{StaticResource AccentBrush}" BorderThickness="0" Visibility="Collapsed" />
                <TextBlock x:Name="SherpaEnStatusText" Text="Ainda não baixado." Foreground="{StaticResource MutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,7,0,0" />
              </StackPanel>
            </Border>
          </UniformGrid>
          <Border Background="{StaticResource CardBrush}" BorderBrush="#FF31343D" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,8,0,0">
            <StackPanel>
              <TextBlock Text="Benchmark de transcrição" Foreground="White" FontSize="14" FontWeight="SemiBold" />
              <TextBlock Text="Escolha o mesmo áudio para comparar os modelos instalados. Vosk já fica carregado no Jey; os outros tempos incluem a inicialização do mecanismo e a transcrição." Foreground="{StaticResource MutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,10" />
              <DockPanel LastChildFill="False">
                <Button x:Name="RecordBenchmarkAudioButton" Content="Gravar áudio · até 30 s" Click="RecordBenchmarkAudio_Click"
                        Padding="11,6" Background="#FF30343E" Foreground="White" BorderThickness="0" Margin="0,0,8,0" />
                <Button x:Name="SelectBenchmarkAudioButton" Content="Escolher áudio base…" Click="SelectBenchmarkAudio_Click"
                        Padding="11,6" Background="#FF30343E" Foreground="White" BorderThickness="0" />
                <TextBlock x:Name="BenchmarkAudioPathText" Text="Nenhum áudio selecionado" Foreground="#FFBFC3CC" FontSize="11"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="10,0,0,0" />
              </DockPanel>
              <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                <TextBlock Text="Idioma do áudio" Foreground="#FFBFC3CC" FontSize="11" VerticalAlignment="Center" Margin="0,0,8,0" />
                <ComboBox x:Name="BenchmarkLanguageCombo" SelectedIndex="0" Width="145" Style="{StaticResource JeyModelComboBoxStyle}">
                  <ComboBoxItem Content="Português" Tag="pt" />
                  <ComboBoxItem Content="Inglês" Tag="en" />
                </ComboBox>
                <Button x:Name="RunBenchmarkButton" Content="Comparar modelos instalados" Click="RunVoiceBenchmark_Click"
                        Padding="11,6" Margin="10,0,0,0" Background="{StaticResource AccentBrush}" Foreground="{StaticResource SurfaceBrush}"
                        FontWeight="SemiBold" BorderThickness="0" />
              </StackPanel>
              <ProgressBar x:Name="BenchmarkProgress" IsIndeterminate="True" Height="4" Margin="0,10,0,0"
                           Background="#FF3A3E48" Foreground="{StaticResource AccentBrush}" BorderThickness="0" Visibility="Collapsed" />
              <TextBlock x:Name="BenchmarkResultText" Text="Grave até 30 segundos ou escolha um arquivo. Recomendação: até 1,5 s bom · até 4 s satisfatório · acima de 4 s lento (não indicado)."
                         Foreground="{StaticResource MutedBrush}" FontSize="11" FontFamily="Consolas" TextWrapping="Wrap" Margin="0,8,0,0" />
            </StackPanel>
          </Border>
        </StackPanel>
        </ScrollViewer>
      </Grid>
      <Grid Grid.Row="3" Margin="0,14,0,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBlock x:Name="StatusText" Grid.Column="0" Text="Atalhos prontos" Foreground="{StaticResource MutedBrush}"
                   FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,10,0"
                   ToolTip="Dê um duplo clique para copiar esta mensagem." MouseLeftButtonDown="StatusText_MouseLeftButtonDown" />
        <Button x:Name="SettingsRetryButton" Grid.Column="1" Content="Registrar atalhos novamente" Click="RetryShortcuts_Click"
                Visibility="Collapsed" Padding="11,7" Margin="0,0,10,0" Background="#FF30343E" Foreground="White"
                BorderThickness="0" VerticalAlignment="Center" />
        <StackPanel x:Name="FooterHints" Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
          <TextBlock x:Name="FooterMemoryText" Foreground="#FF969BA7" FontSize="10" Margin="0,0,12,0"
                     ToolTip="Memória residente do processo JMD, incluindo os modelos Vosk carregados nele, e pico do último processo de transcrição externo." />
          <TextBlock x:Name="FooterVersionText" Foreground="#FF777D89" FontSize="11" Margin="0,0,12,0" />
          <TextBlock Text="↑ ↓ navegar   Enter executar   Esc fechar" Foreground="#FF777D89" FontSize="11" />
        </StackPanel>
      </Grid>
    </Grid>
  </Border>
</Window>
