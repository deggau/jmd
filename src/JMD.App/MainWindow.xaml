<Window x:Class="JMD.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="JMD" Icon="Assets/JMD.png" Width="760" Height="570" MinWidth="650" MinHeight="480"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterScreen" ShowInTaskbar="False" Topmost="True"
        PreviewKeyDown="Window_PreviewKeyDown" Deactivated="Window_Deactivated">
  <Border Background="{StaticResource SurfaceBrush}" BorderBrush="#FF3A3E48" BorderThickness="1"
          CornerRadius="18" Padding="22">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <Grid Grid.Row="0" Margin="0,0,0,18">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Border Width="34" Height="34" CornerRadius="10" Background="{StaticResource AccentBrush}">
            <TextBlock Text="J" Foreground="#FF17191F" FontSize="20" FontWeight="Bold"
                       HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
            <TextBlock x:Name="PageTitle" Text="JMD" Foreground="White" FontSize="18" FontWeight="SemiBold" />
            <TextBlock x:Name="PageSubtitle" Text="Ferramentas rápidas para desenvolvimento" Foreground="{StaticResource MutedBrush}" FontSize="12" />
          </StackPanel>
        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
          <Button x:Name="ExtraButton" Content="..." Click="ExtraButton_Click" Padding="11,8" Margin="0,0,8,0" Background="#FF2A2D35"
                  Foreground="White" BorderThickness="0" ToolTip="Mais opções">
            <Button.ContextMenu>
              <ContextMenu>
                <MenuItem Header="Sobre" Click="AboutMenuItem_Click" />
              </ContextMenu>
            </Button.ContextMenu>
          </Button>
          <Button x:Name="HistoryButton" Content="Histórico" Click="HistoryButton_Click"
                  Padding="14,8" Margin="0,0,8,0" Background="#FF2A2D35" Foreground="White" BorderThickness="0" />
          <Button x:Name="ManageButton" Content="Gerenciar atalhos" Click="ManageButton_Click"
                  Padding="14,8" Margin="0,0,8,0" Background="#FF2A2D35" Foreground="White" BorderThickness="0" />
          <Button Content="×" Click="CloseButton_Click" Width="34" Height="34" FontSize="18"
                  Background="#FF2A2D35" Foreground="White" BorderThickness="0" />
        </StackPanel>
      </Grid>
      <TextBox x:Name="SearchBox" Grid.Row="1" Height="48" Padding="16,12" FontSize="15"
               Background="#FF242730" Foreground="White" BorderBrush="#FF3A3E48"
               CaretBrush="{StaticResource AccentBrush}" TextChanged="SearchBox_TextChanged"
               VerticalContentAlignment="Center" Margin="0,0,0,16"
               ToolTip="Buscar comando…" />
      <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
        <ListBox x:Name="CommandsList" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
          <ListBox.ItemContainerStyle>
            <Style TargetType="ListBoxItem">
              <Setter Property="Padding" Value="0" />
              <Setter Property="Margin" Value="0" />
              <Setter Property="Background" Value="Transparent" />
              <Setter Property="BorderThickness" Value="0" />
            </Style>
          </ListBox.ItemContainerStyle>
          <ListBox.ItemTemplate>
            <DataTemplate>
              <Button Tag="{Binding Id}" Click="CommandButton_Click" Padding="16" Margin="0,0,0,9"
                      Background="{StaticResource CardBrush}" BorderBrush="#FF31343D" BorderThickness="1"
                      HorizontalContentAlignment="Stretch" Cursor="Hand">
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <StackPanel>
                    <TextBlock Text="{Binding Name}" Foreground="White" FontSize="14" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding Description}" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,5,0,0" />
                    <TextBlock Text="{Binding Status}" Foreground="{Binding StatusBrush}" FontSize="11" Margin="0,7,0,0" />
                  </StackPanel>
                  <Border Grid.Column="1" Background="#FF30343E" CornerRadius="6" Padding="9,5" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Shortcut}" Foreground="#FFE4E7EC" FontSize="11" />
                  </Border>
                </Grid>
              </Button>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </ScrollViewer>
      <Grid x:Name="SettingsTabs" Grid.Row="2" Visibility="Collapsed">
        <ScrollViewer x:Name="SettingsPage" VerticalScrollBarVisibility="Auto" Background="#FF17191F">
          <StackPanel x:Name="SettingsPanel" Margin="2,10,2,8" />
        </ScrollViewer>
        <Grid x:Name="HistoryPage" Visibility="Collapsed" Background="#FF17191F">
          <Grid Margin="12">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <TextBlock Text="Buscar nos valores anteriores e convertidos" Foreground="White" FontSize="12" Margin="0,0,0,6" />
            <TextBox x:Name="HistorySearchBox" Grid.Row="1" Height="38" Padding="10,7"
                     Background="#FF242730" Foreground="White" BorderBrush="#FF3A3E48"
                     VerticalContentAlignment="Center" TextChanged="HistorySearchBox_TextChanged"
                     ToolTip="Digite parte de um valor para filtrar o histórico" />
            <DockPanel Grid.Row="2" Margin="0,12,0,12" LastChildFill="False">
              <TextBlock Text="Manter histórico por" Foreground="#FF969BA7" VerticalAlignment="Center" />
              <TextBox x:Name="HistoryRetentionBox" Width="58" Height="30" Margin="8,0,6,0" Padding="5,3"
                       Text="15" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                       Background="#FF242730" Foreground="White" BorderBrush="#FF3A3E48" />
              <TextBlock Text="dias" Foreground="#FF969BA7" VerticalAlignment="Center" />
              <Button Content="Salvar" Click="SaveHistoryRetention_Click" Margin="10,0,0,0" Padding="12,5"
                      Background="#FFB4F36A" Foreground="#FF17191F" BorderThickness="0" />
            </DockPanel>
            <Grid Grid.Row="3">
              <TextBlock x:Name="HistoryEmptyText" Text="Nenhuma conversão encontrada." Foreground="#FF969BA7"
                         HorizontalAlignment="Center" VerticalAlignment="Center" />
              <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="HistoryItemsControl">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border Background="#FF22252D" BorderBrush="#FF31343D" BorderThickness="1"
                              CornerRadius="8" Padding="12" Margin="0,0,0,8">
                        <StackPanel>
                          <DockPanel Margin="0,0,0,8">
                            <TextBlock Text="{Binding CommandName}" Foreground="#FFB4F36A" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding DisplayDate}" Foreground="#FF969BA7"
                                       HorizontalAlignment="Right" DockPanel.Dock="Right" />
                          </DockPanel>
                          <Grid>
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="*" />
                              <ColumnDefinition Width="12" />
                              <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                              <TextBlock Text="Original" Foreground="#FF969BA7" FontSize="11" />
                              <TextBlock Text="{Binding BeforeValue}" Foreground="White" TextWrapping="Wrap"
                                         FontFamily="Consolas" Margin="0,3,0,0" />
                            </StackPanel>
                            <Border Grid.Column="1" BorderBrush="#FF3A3E48" BorderThickness="1,0,0,0" HorizontalAlignment="Center" />
                            <StackPanel Grid.Column="2">
                              <TextBlock Text="Resultado" Foreground="#FF969BA7" FontSize="11" />
                              <TextBlock Text="{Binding AfterValue}" Foreground="White" TextWrapping="Wrap"
                                         FontFamily="Consolas" Margin="0,3,0,0" />
                            </StackPanel>
                          </Grid>
                        </StackPanel>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
            </Grid>
          </Grid>
        </Grid>
      </Grid>
      <Grid x:Name="AboutPage" Grid.Row="2" Visibility="Collapsed" Background="#FF17191F">
        <Border Background="#FF22252D" BorderBrush="#FF31343D" BorderThickness="1" CornerRadius="12"
                Padding="24" HorizontalAlignment="Center" VerticalAlignment="Center" Width="430">
          <StackPanel>
            <TextBlock Text="JMD" Foreground="White" FontSize="24" FontWeight="Bold" />
            <TextBlock Text="Ferramentas rápidas para desenvolvimento" Foreground="#FF969BA7" FontSize="13" Margin="0,4,0,18" />
            <TextBlock x:Name="AboutVersionText" Foreground="White" FontSize="12" />
            <TextBlock Text="Projeto open source" Foreground="#FF969BA7" FontSize="12" Margin="0,5,0,16" />
            <TextBlock x:Name="UpdateStatusText" Text="Verifique se há uma versão mais recente no GitHub." Foreground="#FFB4F36A"
                       TextWrapping="Wrap" FontSize="12" Margin="0,0,0,14" />
            <StackPanel Orientation="Horizontal">
              <Button x:Name="CheckUpdatesButton" Content="Verificar atualizações" Click="CheckUpdatesButton_Click"
                      Padding="12,8" Background="#FFB4F36A" Foreground="#FF17191F" BorderThickness="0" />
              <Button x:Name="InstallUpdateButton" Content="Atualizar agora" Click="InstallUpdateButton_Click"
                      Padding="12,8" Margin="8,0,0,0" Background="#FF2A2D35" Foreground="White"
                      BorderThickness="0" Visibility="Collapsed" />
            </StackPanel>
          </StackPanel>
        </Border>
      </Grid>
      <Grid Grid.Row="3" Margin="0,14,0,0">
        <TextBlock x:Name="StatusText" Text="Atalhos prontos" Foreground="{StaticResource MutedBrush}" FontSize="11" VerticalAlignment="Center" />
        <TextBlock Text="↑ ↓ navegar   Enter executar   Esc fechar" Foreground="#FF777D89" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center" />
      </Grid>
    </Grid>
  </Border>
</Window>
