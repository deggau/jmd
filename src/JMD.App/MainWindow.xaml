<Window x:Class="JMD.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="JMD" Icon="Assets/JMD.png" Width="760" Height="570" MinWidth="650" MinHeight="480"
        WindowStyle="None" Background="{StaticResource SurfaceBrush}"
        WindowStartupLocation="CenterScreen" ShowInTaskbar="False" Topmost="True"
        PreviewKeyDown="Window_PreviewKeyDown" Deactivated="Window_Deactivated">
  <Border Background="{StaticResource SurfaceBrush}" BorderBrush="#FF3A3E48" BorderThickness="1"
          CornerRadius="18" Padding="22">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <Grid Grid.Row="0" Margin="0,0,0,18">
        <Border Background="Transparent" Cursor="SizeAll" VerticalAlignment="Center"
                MouseLeftButtonDown="Header_DragMove">
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Border Width="34" Height="34" CornerRadius="10" Background="{StaticResource AccentBrush}">
              <TextBlock Text="J" Foreground="#FF17191F" FontSize="20" FontWeight="Bold"
                         HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
              <TextBlock x:Name="PageTitle" Text="JMD" Foreground="White" FontSize="18" FontWeight="SemiBold" />
              <TextBlock x:Name="PageSubtitle" Text="Ferramentas rápidas para desenvolvimento" Foreground="{StaticResource MutedBrush}" FontSize="12" />
            </StackPanel>
          </StackPanel>
        </Border>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
          <Button x:Name="ManageButton" Content="Gerenciar atalhos" Click="ManageButton_Click"
                  Padding="14,8" Margin="0,0,8,0" Background="#FF2A2D35" Foreground="White" BorderThickness="0" />
          <Button x:Name="HistoryButton" Content="Histórico" Click="HistoryButton_Click"
                  Padding="14,8" Margin="0,0,8,0" Background="#FF2A2D35" Foreground="White" BorderThickness="0" />
      <Button x:Name="ExtraButton" Content="..." Click="ExtraButton_Click" Padding="11,8" Margin="0,0,8,0" Background="#FF2A2D35"
                  Foreground="White" BorderThickness="0" ToolTip="Mais opções">
            <Button.ContextMenu>
              <ContextMenu>
                <MenuItem Header="Jey" Click="JeyMenuItem_Click" />
                <MenuItem Header="Avançado" Click="AdvancedSettingsMenuItem_Click" />
                <MenuItem Header="Sobre" Click="AboutMenuItem_Click" />
              </ContextMenu>
            </Button.ContextMenu>
          </Button>
          <Button Content="×" Click="CloseButton_Click" Width="34" Height="34" FontSize="18"
                  Background="#FF2A2D35" Foreground="White" BorderThickness="0" />
        </StackPanel>
      </Grid>
      <Grid Grid.Row="1" Margin="0,0,0,16">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBox x:Name="SearchBox" Height="48" Padding="16,12" FontSize="15"
                 Background="#FF242730" Foreground="White" BorderBrush="#FF3A3E48"
                 CaretBrush="{StaticResource AccentBrush}" TextChanged="SearchBox_TextChanged"
                 VerticalContentAlignment="Center" Margin="0,0,12,0" ToolTip="Buscar um comando ou digitar uma frase de workflow…" />
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
          <CheckBox x:Name="KeepAwakeToggle" Content="Manter tela ativa"
                    Style="{StaticResource CompactToggleCheckBoxStyle}" Margin="0,0,12,0"
                    Checked="KeepAwakeToggle_Changed" Unchecked="KeepAwakeToggle_Changed"
                    ToolTip="Solicita ao Windows manter a tela e o sistema ativos. Políticas de segurança ainda podem bloquear a tela." />
          <CheckBox x:Name="HideFromCaptureToggle" Content="Ocultar na captura"
                    Style="{StaticResource CompactToggleCheckBoxStyle}" Margin="0,0,12,0"
                    Checked="HideFromCaptureToggle_Changed" Unchecked="HideFromCaptureToggle_Changed"
                    ToolTip="Oculta a janela do JMD em capturas e compartilhamentos que respeitam o recurso do Windows." />
          <CheckBox x:Name="VoiceWakeWordToggle" Content="Ativar Jey"
                    Style="{StaticResource CompactToggleCheckBoxStyle}"
                    Checked="VoiceWakeWordToggle_Changed" Unchecked="VoiceWakeWordToggle_Changed"
                    ToolTip="Ativa o reconhecimento local pelo microfone. Os modelos do Vosk são incluídos no instalador." />
        </StackPanel>
      </Grid>
      <ListBox x:Name="CommandsList" Grid.Row="2" Background="Transparent" BorderThickness="0"
               HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
               ScrollViewer.VerticalScrollBarVisibility="Auto">
          <ListBox.ItemContainerStyle>
            <Style TargetType="ListBoxItem" BasedOn="{StaticResource KeyboardListItemStyle}">
              <Setter Property="Padding" Value="0" />
              <Setter Property="Margin" Value="0" />
              <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            </Style>
          </ListBox.ItemContainerStyle>
          <ListBox.ItemTemplate>
            <DataTemplate>
              <Grid Margin="0,0,0,9">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Border Grid.ColumnSpan="2" Background="{StaticResource CardBrush}" BorderBrush="#FF31343D" BorderThickness="1" CornerRadius="10" />
                <Button Tag="{Binding Id}" Click="CommandButton_Click" Padding="16"
                        Background="Transparent" BorderThickness="0"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Cursor="Hand"
                        FocusVisualStyle="{StaticResource AccentFocusCue}">
                  <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel>
                      <DockPanel LastChildFill="False">
                        <TextBlock Text="{Binding Name}" Foreground="White" FontSize="14" FontWeight="SemiBold" />
                        <Border Background="#FF30343E" CornerRadius="5" Padding="6,2" Margin="8,0,0,0">
                          <Border.Style>
                            <Style TargetType="Border">
                              <Setter Property="Visibility" Value="Collapsed" />
                              <Style.Triggers><DataTrigger Binding="{Binding IsCustomShortcut}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                            </Style>
                          </Border.Style>
                          <TextBlock Text="Personalizado" Foreground="#FFB4F36A" FontSize="10" />
                        </Border>
                      </DockPanel>
                      <TextBlock Text="{Binding Description}" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,5,0,0" />
                      <TextBlock Text="{Binding Status}" Foreground="{Binding StatusBrush}" FontSize="11" Margin="0,7,0,0" />
                      <TextBlock Text="{Binding VoicePhrasesDisplay}" Foreground="#FFB4F36A" FontSize="11"
                                 TextWrapping="Wrap" Margin="0,5,0,0">
                        <TextBlock.Style>
                          <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers><DataTrigger Binding="{Binding HasVoicePhrases}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                          </Style>
                        </TextBlock.Style>
                      </TextBlock>
                    </StackPanel>
                    <Border Grid.Column="1" Background="#FF30343E" CornerRadius="6" Padding="9,5" VerticalAlignment="Center">
                      <TextBlock Text="{Binding Shortcut}" Foreground="#FFE4E7EC" FontSize="11" />
                    </Border>
                  </Grid>
                </Button>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                  <StackPanel.Style>
                    <Style TargetType="StackPanel">
                      <Setter Property="Visibility" Value="Collapsed" />
                      <Style.Triggers><DataTrigger Binding="{Binding IsCustomShortcut}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                    </Style>
                  </StackPanel.Style>
                  <Button Tag="{Binding Id}" Click="EditCustomCommandButton_Click" Content="Editar" Padding="9,5"
                          Background="#FF30343E" Foreground="White" BorderThickness="0" />
                  <Button Tag="{Binding Id}" Click="RemoveCustomCommandButton_Click" Content="Remover" Padding="9,5" Margin="6,0,0,0"
                          Background="#FF30343E" Foreground="White" BorderThickness="0" />
                </StackPanel>
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
      </ListBox>
      <Grid x:Name="SettingsTabs" Grid.Row="2" Visibility="Collapsed">
        <ScrollViewer x:Name="SettingsPage" VerticalScrollBarVisibility="Auto" Background="#FF17191F">
          <StackPanel x:Name="SettingsPanel" Margin="2,10,2,8" />
        </ScrollViewer>
        <ScrollViewer x:Name="WorkflowSettingsPage" VerticalScrollBarVisibility="Auto" Background="#FF17191F" Visibility="Collapsed">
          <StackPanel x:Name="WorkflowSettingsPanel" Margin="2,10,2,8" />
        </ScrollViewer>
        <Grid x:Name="SqlInTestPage" Visibility="Collapsed" Background="#FF17191F">
          <StackPanel Margin="14">
            <Button Content="← Gerenciar atalhos" Click="BackToShortcutSettings_Click" HorizontalAlignment="Left"
                    Padding="10,6" Margin="0,0,0,12" Background="#FF2A2D35" Foreground="White" BorderThickness="0" />
            <Border Background="#FF22252D" BorderBrush="#FF31343D" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,0,0,10">
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <TextBlock Text="Delimitador da lista" Foreground="White" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                <ComboBox x:Name="SqlDelimiterPicker" Grid.Column="1" Height="36" Padding="8,5"
                          Background="#FF181A20" Foreground="White" BorderBrush="#FF414651">
                  <ComboBoxItem Content="Automático" Tag="" />
                  <ComboBoxItem Content="Vírgula (,)" Tag="," />
                  <ComboBoxItem Content="Pipe (|)" Tag="|" />
                  <ComboBoxItem Content="Ponto e vírgula (;)" Tag=";" />
                  <ComboBoxItem Content="Quebra de linha" Tag="newline" />
                </ComboBox>
              </Grid>
            </Border>
            <Border Background="#FF22252D" BorderBrush="#FF31343D" BorderThickness="1" CornerRadius="10" Padding="14">
              <StackPanel>
                <TextBlock Text="Testar conversão SQL IN" Foreground="White" FontWeight="SemiBold" FontSize="14" />
                <TextBlock Text="Teste a conversão sem alterar o clipboard." Foreground="#FF969BA7" FontSize="11" Margin="0,4,0,8" />
                <TextBox x:Name="TestInput" Text="abc,def,jeg" AcceptsReturn="True" TextWrapping="Wrap" Height="72" Padding="9"
                         Margin="0,2,0,8" Foreground="White" Background="#FF181A20" BorderBrush="#FF414651" />
                <Button Content="Testar conversão" Click="TestButton_Click" HorizontalAlignment="Left" Padding="12,7"
                        Background="#FFB4F36A" Foreground="#FF17191F" BorderThickness="0" />
                <TextBlock x:Name="TestOutput" Text="O resultado será exibido aqui sem alterar o clipboard."
                           TextWrapping="Wrap" Foreground="#FFB4F36A" FontSize="12" Margin="0,9,0,0" />
              </StackPanel>
            </Border>
          </StackPanel>
        </Grid>
        <Grid x:Name="SnippetManagementPage" Visibility="Collapsed" Background="#FF17191F">
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="14">
              <Button Content="← Gerenciar atalhos" Click="BackToShortcutSettings_Click" HorizontalAlignment="Left"
                      Padding="10,6" Margin="0,0,0,12" Background="#FF2A2D35" Foreground="White" BorderThickness="0" />
              <DockPanel Margin="0,0,0,10">
                <Button Content="Adicionar texto" Click="AddSnippetButton_Click" DockPanel.Dock="Right" Padding="10,6"
                        Background="#FFB4F36A" Foreground="#FF17191F" BorderThickness="0" />
                <TextBlock x:Name="SnippetPageTitle" Text="Textos salvos" Foreground="White" FontSize="16" FontWeight="SemiBold"
                           VerticalAlignment="Center" />
              </DockPanel>
              <StackPanel x:Name="SnippetManagementPanel" />
            </StackPanel>
          </ScrollViewer>
        </Grid>
        <Grid x:Name="HistoryPage" Visibility="Collapsed" Background="#FF17191F">
          <Grid Margin="12">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <TextBlock Text="Buscar nos valores anteriores e convertidos" Foreground="White" FontSize="12" Margin="0,0,0,6" />
            <TextBox x:Name="HistorySearchBox" Grid.Row="1" Height="38" Padding="10,7"
                     Background="#FF242730" Foreground="White" BorderBrush="#FF3A3E48"
                     VerticalContentAlignment="Center" TextChanged="HistorySearchBox_TextChanged"
                     ToolTip="Digite parte de um valor para filtrar o histórico" />
            <DockPanel Grid.Row="2" Margin="0,12,0,12" LastChildFill="False">
              <TextBlock Text="Manter histórico por" Foreground="#FF969BA7" VerticalAlignment="Center" />
              <TextBox x:Name="HistoryRetentionBox" Width="58" Height="30" Margin="8,0,6,0" Padding="5,3"
                       Text="15" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                       Background="#FF242730" Foreground="White" BorderBrush="#FF3A3E48" />
              <TextBlock Text="dias" Foreground="#FF969BA7" VerticalAlignment="Center" />
              <Button Content="Salvar" Click="SaveHistoryRetention_Click" Margin="10,0,0,0" Padding="12,5"
                      FocusVisualStyle="{StaticResource DarkFocusCue}"
                      Background="#FFB4F36A" Foreground="#FF17191F" BorderThickness="0" />
            </DockPanel>
            <Grid Grid.Row="3">
              <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>
              <TextBlock x:Name="HistoryEmptyText" Text="Nenhuma conversão encontrada." Foreground="#FF969BA7"
                         HorizontalAlignment="Center" VerticalAlignment="Center" Grid.RowSpan="2" />
              <ScrollViewer x:Name="HistoryScrollViewer" Grid.Row="0" VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="HistoryItemsControl">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,8">
                        <Border.Style>
                          <Style TargetType="Border">
                            <Setter Property="Background" Value="#FF22252D" />
                            <Setter Property="BorderBrush" Value="#FF31343D" />
                            <Style.Triggers>
                              <DataTrigger Binding="{Binding IsNotificationTarget}" Value="True">
                                <Setter Property="Background" Value="#FF303B2C" />
                                <Setter Property="BorderBrush" Value="#FFB4F36A" />
                              </DataTrigger>
                              <DataTrigger Binding="{Binding IsWorkflowExecution}" Value="True">
                                <Setter Property="Background" Value="#FF283125" />
                                <Setter Property="BorderBrush" Value="#FF586E3E" />
                              </DataTrigger>
                              <DataTrigger Binding="{Binding IsFailure}" Value="True">
                                <Setter Property="Background" Value="#FF382428" />
                                <Setter Property="BorderBrush" Value="#FFE05B65" />
                              </DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </Border.Style>
                        <StackPanel>
                          <DockPanel Margin="0,0,0,8">
                            <TextBlock Text="&#xE720;" FontFamily="Segoe MDL2 Assets" Foreground="#FFB4F36A"
                                       Margin="0,0,6,0" VerticalAlignment="Center">
                              <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                  <Setter Property="Visibility" Value="Collapsed" />
                                  <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsVoiceTriggered}" Value="True">
                                      <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                  </Style.Triggers>
                                </Style>
                              </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Text="{Binding CommandName}" FontWeight="SemiBold">
                              <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                  <Setter Property="Foreground" Value="#FFB4F36A" />
                                  <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsFailure}" Value="True">
                                      <Setter Property="Foreground" Value="#FFFF7A83" />
                                    </DataTrigger>
                                  </Style.Triggers>
                                </Style>
                              </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Text="{Binding DisplayDate}" Foreground="#FF969BA7"
                                       HorizontalAlignment="Right" DockPanel.Dock="Right" />
                          </DockPanel>
                          <TextBlock Text="{Binding SourceDisplay}" Foreground="#FF747985" FontSize="10"
                                     TextWrapping="Wrap" Margin="0,-5,0,8" />
                          <TextBlock Text="{Binding AfterValue}" Foreground="White" TextWrapping="Wrap" Margin="0,0,0,8">
                            <TextBlock.Style>
                              <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                  <DataTrigger Binding="{Binding IsTaskAction}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                  </DataTrigger>
                                </Style.Triggers>
                              </Style>
                            </TextBlock.Style>
                          </TextBlock>
                          <TextBlock Text="{Binding VersionChangeDisplay}" Foreground="White" FontSize="13" Margin="0,0,0,8">
                            <TextBlock.Style>
                              <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                  <DataTrigger Binding="{Binding IsVersionUpdate}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                  </DataTrigger>
                                </Style.Triggers>
                              </Style>
                            </TextBlock.Style>
                          </TextBlock>
                          <StackPanel Margin="0,0,0,8">
                            <StackPanel.Style>
                              <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                  <DataTrigger Binding="{Binding IsFailure}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                  </DataTrigger>
                                </Style.Triggers>
                              </Style>
                            </StackPanel.Style>
                            <TextBlock Text="Falhou nesta etapa" Foreground="#FFFF7A83" FontSize="11" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding FailureDetails}" Foreground="#FFFFDADD" FontSize="11"
                                       TextWrapping="Wrap" Margin="0,3,0,0" />
                          </StackPanel>
                          <StackPanel Margin="0,0,0,8">
                            <StackPanel.Style>
                              <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                  <DataTrigger Binding="{Binding IsVoiceTriggered}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                  </DataTrigger>
                                </Style.Triggers>
                              </Style>
                            </StackPanel.Style>
                            <DockPanel LastChildFill="False">
                              <TextBlock Text="Transcrição após Jey" Foreground="#FF969BA7" FontSize="11"
                                         VerticalAlignment="Center" />
                              <Button Tag="{Binding OriginalAudioRequest}" Click="PlayHistoryAudio_Click" ToolTip="Reproduzir áudio gravado"
                                      Padding="6,3" Margin="8,0,0,0" Background="#FF30343E" Foreground="White"
                                      BorderThickness="0" DockPanel.Dock="Right">
                                <Button.Style>
                                  <Style TargetType="Button">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                      <DataTrigger Binding="{Binding HasVoiceAudio}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                      </DataTrigger>
                                    </Style.Triggers>
                                  </Style>
                                </Button.Style>
                                <TextBlock Text="&#xE768;" FontFamily="Segoe MDL2 Assets" FontSize="12" />
                              </Button>
                              <Button Tag="{Binding VoiceTranscript}" Click="CopyHistoryValue_Click" ToolTip="Copiar transcrição"
                                      Padding="6,3" Margin="8,0,0,0" Background="#FF30343E" Foreground="White"
                                      BorderThickness="0" DockPanel.Dock="Right">
                                <TextBlock Text="&#xE8C8;" FontFamily="Segoe MDL2 Assets" FontSize="12" />
                              </Button>
                            </DockPanel>
                            <TextBlock Text="{Binding VoiceTranscript, TargetNullValue=Transcrição indisponível}"
                                       Foreground="White" TextWrapping="Wrap" Margin="0,3,0,0" />
                          </StackPanel>
                          <StackPanel Margin="0,0,0,8">
                            <StackPanel.Style>
                              <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                  <DataTrigger Binding="{Binding HasVoiceDebugInfo}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                  </DataTrigger>
                                </Style.Triggers>
                              </Style>
                            </StackPanel.Style>
                            <TextBlock Text="Depuração de áudio" Foreground="#FF969BA7" FontSize="11" />
                            <TextBlock Text="{Binding VoiceDebugSummary}" Foreground="White" FontSize="11" Margin="0,3,0,0" />
                            <TextBlock Text="{Binding VoiceTranscriptionTimeDisplay}" Foreground="White" FontSize="11" Margin="0,2,0,0" />
                            <TextBlock Text="{Binding VoiceCutDisplay}" Foreground="White" FontSize="11" Margin="0,2,0,0" />
                            <DockPanel LastChildFill="False" Margin="0,4,0,0">
                              <TextBlock Text="Trecho enviado à transcrição" Foreground="#FF969BA7" FontSize="11" VerticalAlignment="Center" />
                              <Button Tag="{Binding TranscriptionAudioRequest}" Click="PlayHistoryAudio_Click" ToolTip="Reproduzir trecho enviado à transcrição"
                                      Padding="6,3" Margin="8,0,0,0" Background="#FF30343E" Foreground="White" BorderThickness="0" DockPanel.Dock="Right">
                                <Button.Style>
                                  <Style TargetType="Button">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                      <DataTrigger Binding="{Binding HasVoiceTranscriptionAudio}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                      </DataTrigger>
                                    </Style.Triggers>
                                  </Style>
                                </Button.Style>
                                <TextBlock Text="&#xE768;" FontFamily="Segoe MDL2 Assets" FontSize="12" />
                              </Button>
                            </DockPanel>
                          </StackPanel>
                          <StackPanel>
                            <StackPanel.Style>
                              <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                  <DataTrigger Binding="{Binding IsDraftSaved}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                  </DataTrigger>
                                  <DataTrigger Binding="{Binding IsDraftRestored}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                  </DataTrigger>
                                </Style.Triggers>
                              </Style>
                            </StackPanel.Style>
                            <DockPanel LastChildFill="False">
                              <TextBlock Text="Rascunho" Foreground="#FF969BA7" FontSize="11" VerticalAlignment="Center" />
                              <Button Tag="{Binding AfterValue}" Click="CopyHistoryValue_Click" ToolTip="Copiar rascunho"
                                      Padding="5,2" Margin="4,0,0,0" Background="#FF30343E" Foreground="White" BorderThickness="0">
                                <TextBlock Text="&#xE8C8;" FontFamily="Segoe MDL2 Assets" FontSize="12" />
                              </Button>
                            </DockPanel>
                            <TextBlock Text="{Binding AfterValue}" Foreground="White" TextWrapping="Wrap"
                                       FontFamily="Consolas" Margin="0,3,0,0" />
                          </StackPanel>
                          <DockPanel LastChildFill="True" Margin="0,0,0,0">
                            <DockPanel.Style>
                              <Style TargetType="DockPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                  <DataTrigger Binding="{Binding IsApplicationLaunch}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                  </DataTrigger>
                                </Style.Triggers>
                              </Style>
                            </DockPanel.Style>
                            <Button Tag="{Binding BeforeValue}" Click="CopyHistoryValue_Click" ToolTip="Copiar aplicativo ou URL chamado"
                                    Padding="5,2" Margin="0,0,6,0" Background="#FF30343E" Foreground="White" BorderThickness="0"
                                    DockPanel.Dock="Left">
                              <TextBlock Text="&#xE8C8;" FontFamily="Segoe MDL2 Assets" FontSize="12" />
                            </Button>
                            <TextBlock Text="{Binding BeforeValue}" Foreground="White" TextWrapping="Wrap"
                                       FontFamily="Consolas" VerticalAlignment="Center" />
                          </DockPanel>
                          <Grid>
                            <Grid.Style>
                              <Style TargetType="Grid">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                  <DataTrigger Binding="{Binding IsDraftSaved}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                  </DataTrigger>
                                  <DataTrigger Binding="{Binding IsDraftRestored}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                  </DataTrigger>
                                  <DataTrigger Binding="{Binding IsApplicationLaunch}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                  </DataTrigger>
                                  <DataTrigger Binding="{Binding IsWorkflowExecution}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                  </DataTrigger>
                                  <DataTrigger Binding="{Binding IsVersionUpdate}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                  </DataTrigger>
                                  <DataTrigger Binding="{Binding IsTaskAction}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                  </DataTrigger>
                                  <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                      <Condition Binding="{Binding IsVoiceTriggered}" Value="True" />
                                      <Condition Binding="{Binding IsVoiceCommand}" Value="False" />
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Collapsed" />
                                  </MultiDataTrigger>
                                </Style.Triggers>
                              </Style>
                            </Grid.Style>
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="*" />
                              <ColumnDefinition Width="12" />
                              <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
